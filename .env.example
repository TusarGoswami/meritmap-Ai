# ─── LLM PROVIDER ───
# Options: anthropic | gemini | openai
LLM_PROVIDER=gemini

# ─── API KEYS ───
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── MODEL NAMES ───
# Fast model: used for extraction, parsing (cheaper/faster)
LLM_FAST_MODEL=gemini-3.5-flash
LLM_STRONG_MODEL=gemini-3.5-flash

# ─── SEARCH ───
# Primary: Tavily. Fallback: DuckDuckGo (no key needed)
TAVILY_API_KEY=

# ─── GITHUB ───
# Optional: increases rate limit from 60 to 5000 req/hr
GITHUB_TOKEN=

# ─── EXCHANGE RATE ───
# Fallback INR rate if API unavailable
DEFAULT_USD_TO_INR=84.0
DEFAULT_EUR_TO_INR=91.0
DEFAULT_CAD_TO_INR=61.0
DEFAULT_SGD_TO_INR=62.0

# ─── SERVER ───
HOST=0.0.0.0
PORT=8000
